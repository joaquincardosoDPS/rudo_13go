params:
    rasp_version: 1
    default_keypress_wait: 2
    channels:
        13GO: dev
steps:
    - launch: 13GO
    - pause: 15
    - press: ok
    - pause: 8
    - press: left
    - press: up
    - press: ok
    - pause: 5
    - press: down
    - press: down
    - press: ok
    - press: right
    - press: ok
    - pause: 5
