<?xml version="1.0" encoding="UTF-8"?>
<!-- DAI de Google (SDK IMA para Roku) en las senales en vivo, como el reproductor
     de Rudo que embebe 13go.cl (LiveStream('hls', assetKey)). Pide el stream con
     los anuncios insertados, avisa la URL por urlData (la pagina la carga en su
     Video) y se queda escuchando el Video para medir cada anuncio. -->
<component name="DAIPlayerTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/tasks/DAIPlayerTask/DAIPlayerTask.brs"/>
    <script type="text/brightscript" uri="pkg:/components/tasks/DAIPlayerTask/convertCompanionToRAF.brs" />

    <interface>
        <!-- Entrada -->
        <field id="video" type="node" />
        <!-- { assetKey, type: "live", contentId } -->
        <field id="streamData" type="assocarray" />
        <!-- true: termina el loop (cambio de senal o salida de la pagina) -->
        <field id="stop" type="boolean" value="false" />
        <!-- Salida -->
        <field id="urlData" type="assocarray" />
        <field id="adPlaying" type="boolean" value="false" />
        <field id="errors" type="stringarray" />
        <field id="streamManagerReady" type="boolean" value="false" />
    </interface>
</component>
