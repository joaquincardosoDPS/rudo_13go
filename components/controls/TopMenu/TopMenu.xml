<?xml version="1.0" encoding="utf-8"?>
<!-- Riel lateral: equivalente a c13_reloaded/src/layout/components/Sidebar.tsx.
     El primer item es "Mi cuenta" y muestra el avatar del perfil activo. -->
<component name="TopMenu" extends="Group">
    <script type="text/brightscript" uri="TopMenu.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <interface>
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <function name="UpdateSelectedTopMenu" />
    </interface>
    <children>
        <Poster id="pExpandGradient" width="1728" height="1080" uri="pkg:/images/overlay/hero_fade_left.png" loadDisplayMode="stretchToFit" translation="[0,0]" visible="false" />
        <!-- Mas padding desde el borde izquierdo (25->45): en una TV real,
             el overscan corta unos px del borde y el contenido quedaba muy
             pegado a la izquierda (ya pasó lo mismo del lado derecho con las
             tarjetas del Home - ver esa nota mas abajo en el historial). -->
        <Poster id="pLogoImage" height="77" loadHeight="77" loadDisplayMode="scaleToFit" translation="[120,30]" />
        <MarkupGrid id="topMenuGrid" itemComponentName="MenuContentItem" numColumns="1" numRows="6" itemSize="[260,90]" itemSpacing="[0,30]" horizFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" translation="[45,200]" />
        <Label id="lHidden" visible="false" />
    </children>
</component>
