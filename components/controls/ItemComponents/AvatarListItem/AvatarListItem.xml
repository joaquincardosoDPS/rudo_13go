<?xml version="1.0" encoding="utf-8"?>
<component name="AvatarListItem" extends="Group">
    <script type="text/brightscript" uri="AvatarListItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="OnItemContentChanged" />
        <field id="focusPercent" type="float" onChange="OnFocusChanged" />
        <field id="gridHasFocus" type="boolean" onChange="OnFocusChanged" />
    </interface>
    <children>
        <MaskGroup id="avatarMask" maskUri="pkg:/images/other/profile_mask.png" maskSize="[160,160]">
            <Poster id="avatarPoster" loadingBitmapUri="pkg:/images/other/default_user.png" loadDisplayMode="scaleToFit => Fill  => or Zoom" failedBitmapUri="pkg:/images/other/default_user.png" width="160" height="160" uri="pkg:/images/other/default_user.png" />
        </MaskGroup>
        <Poster id="focusBorder" uri="pkg:/images/other/borderImage.png" width="160" height="160" visible="true" />
    </children>
</component>