<?xml version="1.0" encoding="utf-8"?>
<component name="SliderView" extends="Group">
    <script type="text/brightscript" uri="SliderView.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <script type="text/brightscript" uri="pkg:/source/managers/RegistryManager.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/ImageUtils.brs" />

    <interface>
        <field id="categoryId" type="string" value="" />
        <field id="isFeatured" type="boolean" value="false" />
        <field id="componentHeight" type="integer" value="0" />
        <field id="content" type="node" alwaysNotify="true" onChange="initialize" />
        <field id="category" type="assocArray" alwaysNotify="true" />
        <field id="itemSelected" type="assocArray" />
        <field id="itemFocused" type="assocArray" />
        <field id="updateContent" type="node" alwaysNotify="true" onChange="updateSliderContent" />
    </interface>
    <children>
        <Group id="gEventPage" translation="[0,0]" visible="false">
            <Poster id="pEventBackground" width="1920" height="796" uri="" loadDisplayMode="scaleToZoom" translation="[0,0]" visible="true" />
            <Poster id="pEvent" height="282" loadHeight="282" loadDisplayMode="scaleToZoom" translation="[211,173]" />
            <Label id="lEventTitle" width="289" height="282" wrap="true" maxLines="2" horizAlign="center" vertAlign="center" translation="[421,173]" />
        </Group>
        <Group id="gCircleClip" clippingRect="[0,0,0,0]">
            <Group id="gCircleTrack" translation="[0,0]" />
        </Group>
        <Animation id="circleSlideAnim" duration="0.35" easeFunction="inOutQuad" repeat="false">
            <Vector2DFieldInterpolator id="circleSlideInterp" key="[0.0, 1.0]" fieldToInterp="gCircleTrack.translation" />
        </Animation>
    </children>
</component>