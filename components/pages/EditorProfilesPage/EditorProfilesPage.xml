<?xml version="1.0" encoding="utf-8"?>
<!-- Seleccion de perfil: equivalente a c13_reloaded/src/pages/WhosThere
     (".main.quienandaahi"). Los perfiles salen del gateway
     (action=firebase, path=/userAccount/{userId}/profiles) y el avatar se
     arma con la URL base de /appData/avatars. -->
<component name="EditorProfilesPage" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/pages/EditorProfilesPage/EditorProfilesPage.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/RokuUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <script type="text/brightscript" uri="pkg:/source/managers/RegistryManager.brs" />

    <interface>
    </interface>

    <children>
        <Rectangle id="backgroundPanel" width="1920" height="1080" />
        <CustomButton id="logoutButton" backGroundImage="pkg:/images/focus/R5T3_35px_outborder_nopadding.9.png" buttonWidth="250" buttonHeight="72" buttonText="Cerrar sesión" isFilledBgOnFocus="false" visible="true" translation="[1570, 60]" />
        <Poster id="brandLogo" height="120" loadDisplayMode="scaleToFit" translation="[0, 190]" />
        <Label id="screenTitle" translation="[0, 340]" width="1920" height="70" text="¿Quién anda ahí?" horizAlign="center" vertAlign="center" />
        <MarkupGrid id="profilesMarkup" itemComponentName="ProfileListItem" itemSpacing="[50, 0]" numRows="1" numColumns="1" itemSize="[201,300]" vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
        <Label id="emptyStateText" translation="[0, 520]" width="1920" height="40" horizAlign="center" vertAlign="center" text="No encontramos perfiles en tu cuenta." visible="false" />
    </children>
</component>
