<?xml version="1.0" encoding="utf-8"?>
<component name="SignUpPage" extends="Group">
    <script type="text/brightscript" uri="SignUpPage.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/RokuUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/Global.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <script type="text/brightscript" uri="pkg:/source/managers/RegistryManager.brs" />

    <interface>
        <field id="enteredName" type="String" alwaysNotify="true" />
        <field id="enteredEmail" type="String" alwaysNotify="true" />
        <field id="enteredPassword" type="String" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="rBackground" width="1920" height="1080" />

        <Group id="gSignUpFlow" visible="true">
            <Poster id="logo" height="150" loadDisplayMode="scaleToFit" translation="[910,128]" />
            <LayoutGroup id="lgSignUpForm" layoutDirection="vert" itemSpacings="[14,20,30]" translation="[708,336]">
                <Label id="stepLabel" text="PASO 1 DE 3" width="504" horizAlign="left" />
                <Label id="titleLabel" text="Ingresa tu nombre" width="504" horizAlign="left" wrap="true" />
                <CustomButton id="inputButton" backGroundImage="pkg:/images/focus/filled_r6.9.png" buttonWidth="504" buttonHeight="72" isFilledBgOnFocus="true" visible="true">
                    <Label id="inputPlaceholderLabel" text="Nombre completo" width="486" height="72" vertAlign="center" translation="[18,0]" />
                </CustomButton>
                <CustomButton id="actionButton" backGroundImage="pkg:/images/focus/R5Filled_30px.9.png" buttonWidth="504" buttonHeight="72" buttonText="CONTINUAR" isFilledBgOnFocus="true" visible="true">
                    <BusySpinner id="signupPreloader" control="start" clockwise="true" spinInterval="0.8" visible="false" />
                </CustomButton>
            </LayoutGroup>
            <Group id="loginLinkGroup" translation="[708,608]">
                <MultiStyleLabel id="loginLinkText" width="510" horizAlign="left" lineSpacing="-2" wrap="false" focusable="true" />
                <Poster id="loginFocusline" uri="pkg:/images/focus/underline.png" width="145" height="3" translation="[228,30]" visible="false" />
            </Group>
        </Group>

        <Group id="gSuccessState" visible="false">
            <Poster id="pBackground" width="1920" height="1080" uri="pkg:/images/other/background.png" />
            <LayoutGroup id="lgSuccessText" layoutDirection="vert" horizAlignment="center" itemSpacings="[32,22,12]" translation="[475,318]">
                <Poster id="successLogo" loadDisplayMode="scaleToFit" height="180" />
                <Label id="successTitle" text="¡Tu cuenta ha sido creada con éxito!" horizAlign="center" width="650" wrap="true" />
                <Label id="successSubtitle" text="En breve podrás disfrutar nuestra aplicación" width="650" horizAlign="center" wrap="true" />
            </LayoutGroup>
            <Timer id="hideSucessScreenTimer" repeat="false" duration="3" />
        </Group>
    </children>
</component>