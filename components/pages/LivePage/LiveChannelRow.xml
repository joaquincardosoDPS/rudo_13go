<?xml version="1.0" encoding="utf-8"?>
<component name="LiveChannelRow" extends="Group">
    <script type="text/brightscript" uri="LiveChannelRow.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <interface>
        <field id="rowWidth" type="float" value="1721" onChange="onLayoutChanged" />
        <field id="rowHeight" type="float" value="117" onChange="onLayoutChanged" />
        <field id="logo" type="string" onChange="onLayoutChanged" />
        <field id="channelName" type="string" onChange="onProgramsChanged" />
        <field id="ringColor" type="string" onChange="onRingColorChanged" />
        <field id="blocked" type="boolean" onChange="onContentChanged" />
        <field id="programs" type="array" onChange="onProgramsChanged" />
        <field id="focusedItemIndex" type="integer" value="-1" onChange="onFocusChanged" />
        <function name="setFocusedItem" />
    </interface>
    <children>
        <Group id="gLogo" translation="[0,0]">
