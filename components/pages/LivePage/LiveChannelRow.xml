            <Poster id="pRing" width="117" height="117" uri="pkg:/images/masks/circle_ring_thin.png" loadDisplayMode="scaleToZoom" />
            <Poster id="pLockOverlay" width="117" height="117" uri="pkg:/images/masks/circle_bg.png" loadDisplayMode="scaleToZoom" blendColor="#000000" opacity="0.46" visible="false" />
            <Poster id="pLock" width="44" height="44" translation="[36.5,36.5]" uri="pkg:/images/live/lock.png" visible="false" />
        </Group>
        <Group id="gItems" translation="[0,0]" />
    </children>
</component>
