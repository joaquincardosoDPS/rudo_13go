<?rokuml version="1.0" encoding="utf-8" ?> 

<!-- a Task handling the playback loop of both content abd ad -->
<component name="PlayerTask" extends="Task">

<script type="text/brightscript" uri="PlayerTask.brs" />

<interface>
    <field id="video" type="node" />
    <field id="currentState" type="string" />
    <field id="isLivePlayer" value="false" type="boolean" />
    <field id="isAdplaying" value="false" type="boolean" />
    <field id="currentPosition" type="integer" />
</interface>

</component>
