            <Label id="mylistSubTitle" horizAlign="center" text="El contenido que agregues a tu lista aparecerá aquí" />
        </LayoutGroup>
        <LayoutGroup id="lgLogin" layoutDirection="vert" horizAlignment="center" itemSpacings="[30]" translation="[959.5,303]" visible="false">
            <Label id="loginTitle" horizAlign="center" text="Inicia sesión para ver tu lista de favoritos." />
            <CustomButton id="loginButton" backGroundImage="pkg:/images/focus/R5Filled_30px.9.png" buttonWidth="200" buttonHeight="56" buttonText="Iniciar Sesión" isFilledBgOnFocus="true" translation="[1670,45]"/>
        </LayoutGroup>
        <PageLoader id="pageLoader" isBackground="false" visible="false" />
    </children>
</component>