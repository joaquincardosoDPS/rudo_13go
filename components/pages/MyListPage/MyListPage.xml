<?xml version="1.0" encoding="UTF-8"?>
<component name="MyListPage" extends="Group">
    <script type="text/brightscript" uri="MyListPage.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/HelpFuncs.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/RokuUtils.brs" />
    <script type="text/brightscript" uri="pkg:/source/helpers/FocusHandler.brs" />
    <interface>
        <field id="isDestroy" type="boolean" alwaysnotify="true" onChange="onPageDestroy"/>
    </interface>
    <children>
        <Label id="mylistPageTitle" horizAlign="right" text="Mi Lista" translation="[95, 180]" />
        <MarkupGrid id="mylistGrid" translation="[95,250]" itemComponentName="CommonItemComponent" itemClippingRect="[0,0,1820,900]" numColumns="5" numRows="3" itemSize="[323,180]" 
            itemSpacing="[30,40]" drawFocusFeedback="true" horizFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="floatingFocus" visible="true" />
        <LayoutGroup id="gAddItem" layoutDirection="vert" horizAlignment="center" itemSpacings="[30]" translation="[960,409]" visible="false">
